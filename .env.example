# ============================================
# 🌐 SITE IDENTITY
# ============================================
SITE_NAME="Your Company Name"
SITE_TAGLINE="Your short, punchy tagline goes here"
CONTACT_EMAIL="contact@example.com"
CONTACT_WHATSAPP="+62 8xx xxxx xxxx"

# ============================================
# 🏢 COMPANY LEGAL / REGISTRATION
# ============================================
COMPANY_NIB="0000000000000"                                  # 13-digit Nomor Induk Berusaha
COMPANY_KBLI="00000, 00000, 00000"                           # Klasifikasi Baku Lapangan Usaha Indonesia
COMPANY_ADDRESS="Street address, City, Province Postal Code, Country"

# ============================================
# ⏱️  SERVICE COMMITMENT
# ============================================
# How many hours the team promises to reply to an RFQ.
# ⚠️  Only promise what you can consistently meet.
RFQ_REPLY_HOURS=12

# ============================================
# 📊 TRUST STATS (shown on homepage / hero)
# Format examples: "35+", "12,500+", "100%"
# Leave blank to hide the stat on the site.
# ============================================
STAT_COUNTRIES="XX+"
STAT_VOLUME="X,XXX+"
STAT_COMPLIANCE="100%"

# ============================================
# 🖼️  IMAGES & MEDIA
# ============================================
# Comma-separated list of allowed image hosts (for next/image or <img> remote patterns)
# Must include the host used by HERO_BG_URL and ABOUT_IMAGE_URL above.
IMAGE_HOST="cdn.example.com"

# Hero background image (full-width banner on homepage)
HERO_BG_URL="https://cdn.example.com/images/hero.jpg"

# About section image
ABOUT_IMAGE_URL="https://cdn.example.com/images/about.jpg"
